# WandbLogger
WANDB_API_KEY=your_api_key_here
WANDB_ENTITY=your_username_or_team
# optional, overrides constructor
WANDB_PROJECT=your_project_name

# The boileroom image tag used for Modal and Apptainer backends.
# Must be set BEFORE importing bagel/boileroom (the Modal image is locked at import time).
#
# Needed in practice on the current pin: boileroom is pinned to a main commit whose version (0.4.5) is the
# next release target, not something that was ever published. Only prereleases (0.4.5-alpha.N) exist as
# images, so the default lookup asks for a tag that is not there and the pull fails. Set this to the newest
# published prerelease -- list them at https://hub.docker.com/r/jakublala/boileroom-esmfold2/tags
# BOILEROOM_IMAGE_TAG=0.4.5-alpha.15
