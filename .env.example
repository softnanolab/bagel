# WandbLogger
WANDB_API_KEY=your_api_key_here
WANDB_ENTITY=your_username_or_team
# optional, overrides constructor
WANDB_PROJECT=your_project_name

# Optional override for the boileroom image tag used by the Modal and Apptainer backends.
#
# You do not need to set this. Importing bagel applies DEFAULT_BOILEROOM_IMAGE_TAG (see bagel/__init__.py),
# a published prerelease that matches the pinned boileroom commit. Set it only to use a different image.
# Published tags: https://hub.docker.com/r/jakublala/boileroom-esmfold2/tags
# BOILEROOM_IMAGE_TAG=0.4.5-alpha.16
